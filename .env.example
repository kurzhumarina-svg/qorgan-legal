# ─────────────────────────────────────────────────────────────
# QORGAN Legal — переменные окружения
# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает — там ваши секреты.
# ─────────────────────────────────────────────────────────────

# База данных: Neon Postgres (neon.com → Connection string → Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
# Модель для бота
#
# Код общается с моделью через OpenAI-совместимый интерфейс, поэтому подходит
# любой из провайдеров ниже — меняются только эти три строки, приложение не трогаем.
# Раскомментируйте нужный блок.
#
# Groq — бесплатно, быстро, регистрация по email или Google:
#   console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
#
# OpenRouter — один ключ на десятки моделей, есть бесплатные:
#   openrouter.ai/keys
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct
#
# Mistral (Европа):
#   console.mistral.ai/api-keys
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_API_KEY=
# AI_MODEL=mistral-small-latest
#
# DeepSeek — дёшево, но нужен платёж:
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
#
# Google Gemini — тоже умеет OpenAI-совместимый режим:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash
#
# Локальная модель через Ollama (без интернета, качество ниже):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5:7b
#
# Запасные модели через запятую — на случай, если основная перегружена (429).
# Особенно актуально для бесплатных моделей: они живут в общем пуле.
# AI_MODEL_FALLBACK=
#
# Посмотреть, какие модели доступны вашему ключу: npm run ai:models
# ─────────────────────────────────────────────────────────────

# Telegram (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Ваш числовой id из @userinfobot — туда придут уведомления о заявках
TELEGRAM_ADMIN_CHAT_ID=
# Секрет вебхука: генерируется командой npm run tg:webhook
TELEGRAM_WEBHOOK_SECRET=

# Админ-панель (/admin)
ADMIN_PASSWORD=
# Соль для подписи cookie-сессии: любая длинная случайная строка
AUTH_SECRET=

# Публичный адрес сайта. Локально — localhost, после деплоя — адрес с Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000
